
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-phone-agent-computer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],

  // ── 可选 ①：isolate shell（需要 worker_loaders beta 能力）──
  // 想开启的话：
  // 1. 把上面一行改成 "compatibility_flags": ["nodejs_compat", "experimental"]
  // 2. 取消下一行的注释
  // 没有该能力的账号保持现状即可（内嵌 shell 照常可用）。
  // "worker_loaders": [{ "binding": "LOADER" }],

  // ── 可选 ②：容器模式 = 真 Linux ──
  // 当前关闭容器模式，使用项目内嵌 shell。
  // 如需启用容器模式，需要满足 Cloudflare Workers Paid 等条件。

  "durable_objects": {
    "bindings": [
      {
        "class_name": "Computer",
        "name": "Computer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Computer"]
    }
  ]
}
